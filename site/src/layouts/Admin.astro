---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} — Admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="navlite">
      <a class="brand" href="/admin">commandes</a>
      <a class="push" href="/admin/photos">photos</a>
      <a href="/admin/export.csv">export CSV</a>
      <a href="/" target="_blank">voir le site</a>
      <a href="/admin/deconnexion">déconnexion</a>
    </nav>
    <main class="admin">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .admin { max-width: 1180px; margin: 0 auto; padding: 32px var(--pad-x) 60px; }
  .admin h1 { font-size: 34px; margin-bottom: 18px; }
  .admin table.list { width: 100%; border-collapse: collapse; font-size: 15px; }
  .admin .list th { background: var(--navy); color: var(--cream); text-align: left; padding: 12px; font-weight: 800; }
  .admin .list td { padding: 12px; border-bottom: 1px solid var(--cream-2); vertical-align: top; }
  .admin .list tr:hover td { background: var(--sand); }
  .admin .pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 13px; font-weight: 800; white-space: nowrap; }
  .pill.attente_paiement { background: #fde8c8; color: #7a4a00; }
  .pill.payee { background: var(--olive); color: var(--cream); }
  .pill.expediee { background: var(--navy); color: var(--cream); }
  .pill.annulee { background: #ddd; color: #555; }
  .admin .tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 20px; }
  .admin .tabs a { padding: 8px 14px; border-radius: 999px; border: 2px solid var(--navy); color: var(--navy); font-weight: 700; font-size: 14px; }
  .admin .tabs a.on { background: var(--navy); color: var(--cream); }
  @media (max-width: 760px) {
    .admin .list .opt { display: none; }
  }
</style>
