---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import T from '../components/T.astro';

const buy = '/panier?ajouter=1';
---
<Base title="Les hormones d'Yvonne — Vanessa Gandino">
  <!-- HERO -->
  <section class="hero on-navy">
    <div class="grid-2 hero-grid">
      <div>
        <h1 class="bigword hero-title"><T k="hero_titre" /></h1>
        <p class="lead"><T k="hero_accroche" /></p>
        <div class="cta-row" style="margin-top:34px;">
          <a class="cta" href={buy}><T k="bouton_principal" /></a>
          <button type="button" class="cta outline" data-open-extract><T k="bouton_extrait" /></button>
        </div>
      </div>
      <figure class="cover shadow-dark">
        <Photo slot="couverture" alt="Couverture du livre Les hormones d'Yvonne" sizes="(max-width: 760px) 70vw, 360px" eager />
      </figure>
    </div>
  </section>

  <!-- LE LIVRE -->
  <section id="livre" class="section book">
    <h2 class="h-52"><T k="livre_titre" /></h2>
    <div class="grid-3 pillars">
      <div><span><T k="pilier1_titre" /></span><p><T k="pilier1_texte" /></p></div>
      <div><span><T k="pilier2_titre" /></span><p><T k="pilier2_texte" /></p></div>
      <div><span><T k="pilier3_titre" /></span><p><T k="pilier3_texte" /></p></div>
    </div>
  </section>

  <!-- CITATION -->
  <section class="section on-navy">
    <h2 class="bigword hashtag"><T k="hashtag" /></h2>
    <blockquote class="quote"><T k="citation" /></blockquote>
    <div style="display:flex; justify-content:flex-end; margin-top:32px;"><a class="cta" href={buy}><T k="citation_bouton" /></a></div>
  </section>

  <!-- COMMANDER -->
  <section id="commander" class="section">
    <div class="grid-2 order-grid">
      <figure class="cover shadow-light">
        <Photo slot="couverture" alt="Couverture du livre Les hormones d'Yvonne" sizes="(max-width: 760px) 70vw, 320px" />
      </figure>
      <div>
        <h2 style="font-size:38px;"><T k="commander_titre" /></h2>
        <p class="with-box"><span class="box"><Icon name="package" size={23} /></span><T k="commander_livraison" /></p>
        <div class="cta-row" style="margin-top:26px;">
          <a class="cta" href={buy}><T k="commander_bouton" /></a>
          <a class="cta outline" href="#distribution"><T k="commander_bouton_ou" /></a>
        </div>
        <p class="fast"><Icon name="truck" size={22} /> <T k="commander_rapide" /></p>
      </div>
    </div>
  </section>

  <!-- AUTRICE -->
  <section id="autrice" class="section on-navy">
    <div class="grid-2 author-grid">
      <figure class="portrait">
        <Photo slot="portrait" alt="Portrait de Vanessa Gandino" sizes="(max-width: 760px) 90vw, 360px" />
      </figure>
      <div>
        <h2 class="bigword" style="font-size:52px;"><T k="autrice_nom" /></h2>
        <p style="font-size:18px; line-height:1.5; margin:24px 0 0;"><T k="autrice_intro" /></p>
        <p class="author-quote"><T k="autrice_citation" /></p>
        <p style="font-size:17px; margin:22px 0 0; color:var(--peach);"><T k="autrice_signature" /></p>
      </div>
    </div>
  </section>

  <!-- OÙ LE TROUVER -->
  <section id="distribution" class="section on-navy distribution">
    <div class="dist-head">
      <div>
        <h2 style="font-size:40px;"><T k="dist_titre" /></h2>
        <p><T k="dist_intro" /></p>
      </div>
    </div>
    <div class="grid-3 cards">
      <div class="card">
        <span class="ic"><Icon name="globe" /></span>
        <span class="card-title"><T k="dist_ligne_titre" /></span>
        <p><T k="dist_ligne_texte" /> <a href="/panier?ajouter=1"><T k="dist_ligne_lien" /></a></p>
      </div>
      <div class="card">
        <span class="ic"><Icon name="store" /></span>
        <span class="card-title"><T k="dist_concept_titre" /></span>
        <p><T k="dist_concept_texte" /></p>
        <a class="partner" href="https://www.instagram.com/legardemanger_" target="_blank" rel="noopener">
          <Photo slot="partenaire" alt="" sizes="44px" />
          <span><T k="dist_partenaire_nom" /><br /><small><T k="dist_partenaire_lien" /></small></span>
        </a>
      </div>
      <div class="card">
        <span class="ic"><Icon name="book-open" /></span>
        <span class="card-title"><T k="dist_librairies_titre" /></span>
        <p><T k="dist_librairies_texte" /></p>
      </div>
    </div>
    <p class="pro"><T k="dist_pro" /> <a href="mailto:contact@vanessagandino.fr">contact@vanessagandino.fr</a></p>
  </section>

  <dialog class="extract" aria-label="Extrait : quatrième de couverture">
    <form method="dialog"><button class="close" aria-label="Fermer"><Icon name="x" /></button></form>
    <Photo slot="extrait" alt="Quatrième de couverture : « Pour raconter une vie entière sous influence hormonale, il fallait une voix. Une voix de femme. Yvonne. »" sizes="(max-width: 760px) 92vw, 480px" />
    <a class="cta" href={buy} style="margin-top:18px; width:100%;"><T k="bouton_principal" /></a>
  </dialog>
</Base>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.extract');
  document.querySelectorAll('[data-open-extract]').forEach((b) => b.addEventListener('click', () => dialog?.showModal()));
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style>
  .hero { padding: 76px var(--pad-x) 68px; }
  .hero-grid { grid-template-columns: 1.25fr 0.75fr; gap: 56px; }
  .hero-title { font-size: 82px; }
  .lead { font-size: 20px; line-height: 1.45; margin: 30px 0 0; max-width: 34ch; }
  .lead b { font-weight: 900; }
  .cover { margin: 0; aspect-ratio: 400 / 600; }
  .cover :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .shadow-dark { box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35); }
  .shadow-light { box-shadow: 0 18px 44px rgba(14, 48, 73, 0.22); }

  .book { padding-top: 72px; padding-bottom: 72px; }
  .h-52 { font-size: 52px; }
  .pillars { gap: 32px; margin-top: 44px; }
  .pillars span { display: block; font-weight: 900; font-size: 19px; color: var(--terra); }
  .pillars p { font-size: 16.5px; line-height: 1.6; margin: 8px 0 0; }

  .hashtag { font-size: 44px; color: var(--peach); }
  .quote { font-weight: 800; font-size: 30px; line-height: 1.28; margin: 36px 0 0 auto; max-width: 26ch; }

  .order-grid { grid-template-columns: 0.55fr 1fr; gap: 56px; }
  .with-box { font-size: 17px; line-height: 1.6; margin: 14px 0 0; max-width: 38ch; display: flex; align-items: center; gap: 12px; }
  .box { display: inline-grid; place-content: center; width: 42px; height: 42px; flex: 0 0 auto; border-radius: 12px; background: var(--olive); color: var(--cream); }
  .fast { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14.5px; color: var(--olive); margin: 26px 0 0; }

  .author-grid { grid-template-columns: 0.5fr 1fr; gap: 52px; }
  .portrait { margin: 0; background: var(--cream); aspect-ratio: 3 / 4; }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .author-quote { font-size: 17px; line-height: 1.6; margin: 20px 0 0; font-style: italic; max-width: 46ch; color: color-mix(in srgb, var(--cream) 86%, transparent); }

  .distribution { border-top: 1px solid rgba(249, 240, 218, 0.12); }
  .dist-head { display: flex; align-items: flex-end; gap: 40px; flex-wrap: wrap; }
  .dist-head p { font-size: 17px; line-height: 1.6; margin: 12px 0 0; max-width: 46ch; color: var(--cream-2); }
  .cards { gap: 18px; margin-top: 38px; }
  .card { background: rgba(249, 240, 218, 0.1); border-radius: 16px; padding: 28px; }
  .card-title { display: block; font-weight: 900; font-size: 22px; margin-top: 14px; letter-spacing: -0.02em; }
  .card p { font-size: 15px; line-height: 1.55; margin: 8px 0 0; color: var(--muted-on-navy); }
  .card p a { color: var(--peach); font-weight: 700; }
  .partner { display: flex; align-items: center; gap: 10px; margin-top: 16px; color: var(--cream); font-size: 14px; font-weight: 700; }
  .partner:hover { color: var(--cream); }
  .partner :global(img) { width: 44px; height: 44px; border-radius: 8px; object-fit: cover; }
  .partner small { font-weight: 400; color: var(--muted-on-navy); font-size: 14px; }
  .pro { font-size: 15px; margin: 26px 0 0; color: var(--faint-on-navy); }
  .pro a { color: var(--cream-2); }

  .extract { border: none; border-radius: 16px; padding: 22px; width: min(520px, 94vw); max-width: none; max-height: 94vh; background: var(--cream); }
  .extract::backdrop { background: rgba(14, 30, 50, 0.7); }
  .extract :global(img) { width: 100%; border-radius: 4px; }
  .close { position: sticky; top: 0; float: right; margin: -8px -8px 8px 8px; width: 44px; height: 44px; border-radius: 999px; border: none; background: var(--navy); color: var(--cream); cursor: pointer; display: grid; place-content: center; }

  @media (max-width: 1024px) {
    .hero-title { font-size: 66px; }
    .cards .card:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .hero { padding-top: 44px; padding-bottom: 52px; }
    .hero-grid { gap: 36px; }
    .hero-title { font-size: 48px; }
    .cover { width: 70%; margin: 0 auto; }
    .order-grid .cover { order: 2; }
    .h-52, .author-grid h2 { font-size: 38px !important; }
    .quote { font-size: 24px; }
    .portrait { width: 80%; }
    .cards .card:last-child { grid-column: auto; }
  }
</style>
