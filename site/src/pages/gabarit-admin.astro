---
// Gabarit des pages PHP d'administration. PHP remplace %%TITLE%% et <!--%%CONTENT%%-->.
import Admin from '../layouts/Admin.astro';
---
<Admin title="%%TITLE%%">
  <Fragment set:html="<!--%%CONTENT%%-->" />
</Admin>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-from]').forEach((b) =>
    b.addEventListener('click', async () => {
      const src = document.querySelector(b.dataset.copyFrom!);
      await navigator.clipboard.writeText(src?.textContent ?? '');
      b.textContent = 'Copié ✓';
    }),
  );
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) =>
    f.addEventListener('submit', (e) => {
      if (!confirm(f.dataset.confirm!)) e.preventDefault();
    }),
  );
</script>

<style is:global>
  .detail { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 20px 0 32px; }
  .detail h2, .actions h2 { font-size: 22px; margin-bottom: 10px; }
  .admin pre { background: #fff; border-radius: 10px; padding: 14px; font-size: 14.5px; white-space: pre-wrap; margin: 0 0 14px; }
  .actions { display: flex; flex-direction: column; gap: 18px; }
  .act { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; padding: 18px; border: 2px solid var(--cream-2); border-radius: 14px; }
  .act > label { font-size: 14.5px; display: flex; gap: 6px; align-items: center; }
  .act .field { min-width: 240px; }
  .act.note { flex-direction: column; align-items: stretch; }
  .ship-table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
  .ship-table th { text-align: left; font-size: 14px; padding: 0 6px 8px 0; }
  .ship-table td { padding: 4px 6px 4px 0; }
  .ship-table input { width: 100%; font: 400 16px/1.4 Figtree, sans-serif; border: 2px solid var(--navy); border-radius: 8px; padding: 8px 10px; background: #fff; color: var(--navy); }
  .text-group { margin: 0 0 20px; }
  .text-group h2 { font-size: 22px; margin-bottom: 14px; }
  .text-group .field { margin-bottom: 16px; }
  .text-group textarea { width: 100%; font: 400 16px/1.5 Figtree, sans-serif; border: 2px solid var(--navy); border-radius: 8px; padding: 8px 10px; background: #fff; color: var(--navy); resize: vertical; }
  .text-group .small { margin-top: 8px; padding: 6px 14px; font-size: 14px; }
  .save-bar { position: sticky; bottom: 0; padding: 14px 0; background: var(--cream); }
  .photo-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin: 20px 0; }
  .photo-card { display: flex; flex-direction: column; gap: 10px; }
  .photo-card h2 { font-size: 20px; }
  .photo-card .hint { margin: 0; font-size: 14px; }
  .photo-preview { width: 100%; height: 220px; object-fit: contain; background: #fff; border-radius: 10px; }
  .photo-form { display: flex; flex-direction: column; gap: 10px; }
  .photo-form input[type=file] { font: inherit; font-size: 14px; }
  .login { max-width: 380px; margin: 40px auto; display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 760px) { .detail { grid-template-columns: 1fr; } }
</style>
