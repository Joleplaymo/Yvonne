---
// Photo remplaçable depuis l'admin (/admin/photos), servie par php/photo.php.
// Les versions d'origine sont générées au build depuis src/assets (scripts/assemble.mjs).
interface Props {
  slot: 'couverture' | 'portrait' | 'extrait' | 'partenaire';
  alt: string;
  sizes: string;
  class?: string;
  eager?: boolean;
}
const { slot, alt, sizes, class: className, eager = false } = Astro.props;
const src = (w: number) => `/photo/${slot}?w=${w}`;
---
<img
  src={src(480)}
  srcset={`${src(480)} 480w, ${src(960)} 960w`}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
