---
import {
  Package, Truck, Globe, Store, BookOpen, Mail, ShoppingBag, Minus, Plus, MapPin, X, ArrowLeft, Check, Copy,
} from 'lucide-static';

const icons = {
  package: Package, truck: Truck, globe: Globe, store: Store, 'book-open': BookOpen, mail: Mail,
  'shopping-bag': ShoppingBag, minus: Minus, plus: Plus, 'map-pin': MapPin, x: X, 'arrow-left': ArrowLeft,
  check: Check, copy: Copy,
};

interface Props {
  name: keyof typeof icons;
  size?: number;
  stroke?: number;
}
const { name, size = 24, stroke = 2.75 } = Astro.props;
const svg = icons[name]
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace(/stroke-width="2"/, `stroke-width="${stroke}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Fragment set:html={svg} />
