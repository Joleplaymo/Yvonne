Options -Indexes
DirectoryIndex index.php index.html
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
</IfModule>

# Bases de données et sauvegardes : jamais servies.
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    # Pas de règle pour les images : les photos remplaçables (/photo) gèrent leur propre cache court.
</IfModule>

RewriteEngine On

# HTTPS obligatoire (sauf en local et derrière un proxy qui a déjà terminé le HTTPS).
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Code interne.
RewriteRule ^_prive(/|$) - [F,L]

# Routes dynamiques (PHP).
RewriteRule ^api/config$ api/config.php [L]
RewriteRule ^api/orders$ api/orders.php [L]
RewriteRule ^merci$ merci.php [L,QSA]
RewriteRule ^admin/?$ admin/index.php [L,QSA]
RewriteRule ^admin/export\.csv$ admin/export.php [L]
RewriteRule ^admin/deconnexion$ admin/deconnexion.php [L]
RewriteRule ^admin/photos$ admin/photos.php [L]
RewriteRule ^admin/textes$ admin/textes.php [L]
RewriteRule ^admin/couleurs$ admin/couleurs.php [L]
RewriteRule ^admin/accueil$ admin/accueil.php [L]
RewriteRule ^(panier|commande)$ page.php?p=$1 [L,QSA]
RewriteRule ^admin/livraison$ admin/livraison.php [L]
RewriteRule ^photo/([a-z0-9-]+)$ photo.php?slot=$1 [L,QSA]
RewriteRule ^admin/(YV-[0-9]+)$ admin/commande.php?ref=$1 [L,QSA]

# Pages statiques sans extension : /panier -> panier.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([a-z0-9-]+)$ $1.html [L]
