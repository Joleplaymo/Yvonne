# Copier en .env puis remplir. Ne jamais versionner le .env.

# Domaine public (sans https://). Caddy obtient le certificat HTTPS tout seul.
DOMAIN=leshormonesdyvonne.vanessagandino.fr

# --- Boutique (un redémarrage suffit après modification) ---
BOOK_PRICE_EUR=10
MAX_QTY=6
# Frais de port Mondial Relay par quantité minimale : "1:4.90,2:5.90,4:7.50"
# = 4,90 € pour 1 livre, 5,90 € pour 2 ou 3, 7,50 € à partir de 4. À ajuster sur vos tarifs réels.
SHIPPING_TABLE=1:4.90,2:5.90,4:7.50

# Lien Revolut. {amount} = montant (ex. 35.90), {ref} = référence commande (ex. YV-0007).
# Sans {amount}, le client saisit lui-même le montant affiché.
REVOLUT_LINK_TEMPLATE=https://revolut.me/v_gandino

# Code enseigne Mondial Relay pour le widget carte. Vide = saisie manuelle du point relais.
# "BDTEST  " (avec 2 espaces) = compte de démonstration, pour tester uniquement.
MR_BRAND=

# --- E-mails ---
# Format : smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465 (vide = mails affichés dans les logs)
SMTP_URL=
MAIL_FROM=Vanessa Gandino <contact@vanessagandino.fr>
ADMIN_EMAIL=contact@vanessagandino.fr

# --- Administration (/admin) ---
ADMIN_USER=vanessa
# Mot de passe long et unique. Vide = admin désactivée.
ADMIN_PASSWORD=
