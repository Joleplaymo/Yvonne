# Version Docker uniquement (sur Hostinger, la configuration est dans boutique-data/config.php).
# Copier en .env puis remplir. Ne jamais versionner le .env.

# Domaine public (sans https://). Caddy obtient le certificat HTTPS tout seul.
DOMAIN=leshormonesdyvonne.vanessagandino.fr

# --- Boutique (un redémarrage suffit après modification) ---
BOOK_PRICE_EUR=10
MAX_QTY=6
# Frais de port par quantité minimale : 4,90 € pour 1 livre, 5,90 € pour 2-3, 7,50 € dès 4. À ajuster.
SHIPPING_TABLE=1:4.90,2:5.90,4:7.50
# {amount} = montant (ex. 35.90), {ref} = référence. Sans {amount}, le client saisit le montant affiché.
# Peut être remplacé depuis /admin/paiement (le réglage de l'admin prime).
REVOLUT_LINK_TEMPLATE=https://revolut.me/v_gandino
# Code enseigne Mondial Relay (carte). Vide = saisie manuelle. "BDTEST  " = démo (2 espaces).
MR_BRAND=

# --- E-mails : smtp | mail | log ---
MAIL_MODE=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@vanessagandino.fr
SMTP_PASSWORD=
MAIL_FROM=contact@vanessagandino.fr
MAIL_FROM_NAME=Vanessa Gandino
ADMIN_EMAIL=contact@vanessagandino.fr

# --- Administration (/admin) ---
ADMIN_USER=vanessa
# Long et unique. Vide = admin désactivée.
ADMIN_PASSWORD=
